FAMILY_SESSION_TOKEN=replace-with-a-long-random-family-token
PATIENT_ID=00000000-0000-4000-8000-000000000001
BOOTSTRAP_HOUSEHOLD_ID=00000000-0000-4000-8000-000000000100
BOOTSTRAP_DEVICE_ID=00000000-0000-4000-8000-000000000200
BACKEND_BINDING_ID=backend-binding-development-1
CREDENTIAL_ID=device-credential-development-1
CREDENTIAL_REVISION=1
BOOTSTRAP_FAMILY_SESSION_ID=00000000-0000-4000-8000-000000000300
